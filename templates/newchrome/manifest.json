{
    "manifest_version": 3,
    "name": "GraphDLC",
    "version": "x.y.z.w",
    "description": "GraphDLC для стрелочек...",
    "action": {
        "default_icon": "images/icon128.png",
        "default_title": "GraphDLC"
    },
    "icons": {
        "128": "images/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://logic-arrows.io/*",
                "https://v1_2.logic-arrows.io/*"
            ],
            "js": ["index.js"],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["index.js.map"],
            "matches": ["<all_urls>"]
        }
    ],
    "host_permissions": [
        "https://logic-arrows.io/*",
        "https://v1_2.logic-arrows.io/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'",
        "web_accessible_resources": "script-src 'self'; object-src 'self'"
    }
}

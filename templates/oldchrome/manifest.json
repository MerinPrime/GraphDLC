{
    "manifest_version": 2,
    "name": "name",
    "version": "x.y.z.w",
    "description": "description",
    "icons": {
        "128": "images/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://logic-arrows.io/*",
                "https://v1_2.logic-arrows.io/*"
            ],
            "js": ["injector.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "web_accessible_resources": ["index.js"],
    "background": {
        "scripts": ["background.js"]
    },
    "browser_action": {}
}

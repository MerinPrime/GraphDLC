{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["DOM", "ES2022"],
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "outDir": "./dist",
    "noEmit": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@logic-arrows/*": ["./logic-arrows/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "webpack.config.ts",
    "webpack/**/*",
    "logic-arrows/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

{
  "name": "graphdlc",
  "version": "3.0.0-dev",
  "description": "GraphDLC для стрелочек...",
  "main": "index.js",
  "scripts": {
    "build": "webpack --env production",
    "dev": "concurrently \"npm run watch:game\" \"npm run watch:graphdlc\" \"npm run server\"",
    "watch:game": "cd logic-arrows && webpack --watch --output-path=../dist/dev",
    "watch:graphdlc": "webpack --config webpack.config.ts --env development --watch",
    "server": "webpack serve --config webpack.config.ts --env development --stats=minimal"
  },
  "keywords": [],
  "author": "MerinPrime",
  "license": "ISC",
  "devDependencies": {
    "@types/deflate-js": "^0.2.2",
    "@types/node": "^25.9.1",
    "@types/webpack": "^5.28.5",
    "@types/zip-webpack-plugin": "^3.0.6",
    "concurrently": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.4",
    "zip-webpack-plugin": "^4.0.3"
  },
  "dependencies": {
    "deflate-js": "^0.2.3"
  }
}
